# Адрес, на котором gRPC-сервер будет принимать подключения.
GRPC_ADDR=:8080

# Путь к файлу DNS-конфигурации.
# Во время разработки можно указать временный файл вместо системного /etc/resolv.conf.
RESOLV_CONF_PATH=/etc/resolv.conf

# Адрес gRPC-сервера, к которому CLI-клиент подключается по умолчанию.
DEFAULT_ADDR=127.0.0.1:8080

# Максимальное время ожидания ответа от сервера для одного CLI-запроса.
REQUEST_TIMEOUT=5s
